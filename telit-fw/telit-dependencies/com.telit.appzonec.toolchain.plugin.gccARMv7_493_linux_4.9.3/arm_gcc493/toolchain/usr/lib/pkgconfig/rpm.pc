##
##  rpm.pc -- RPM pkg-config(1) specification
##

suffix=
prefix=/jenhome/jenkins/jobs/LE910Cx_Multi_DAILY/workspace/build/apps_proc/poky/build/tmp-glibc/sysroots/x86_64-linux/usr
exec_prefix=/jenhome/jenkins/jobs/LE910Cx_Multi_DAILY/workspace/build/apps_proc/poky/build/tmp-glibc/sysroots/x86_64-linux/usr
includedir=/jenhome/jenkins/jobs/LE910Cx_Multi_DAILY/workspace/build/apps_proc/poky/build/tmp-glibc/sysroots/x86_64-linux/usr/include${suffix}
libdir=/jenhome/jenkins/jobs/LE910Cx_Multi_DAILY/workspace/build/apps_proc/poky/build/tmp-glibc/sysroots/x86_64-linux/usr/lib

Name: rpm
Description: RPM Package Manager
Version: 5.4.14
URL: http://rpm5.org/
Cflags: -I${includedir}/rpm
Libs: -L${libdir} -lrpmbuild${suffix} -lrpm${suffix} -lrpmdb${suffix} -lrpmio${suffix} -lrpmconstant${suffix} -lrpmmisc${suffix}
Libs.private: -lacl -lattr -lossp-uuid -lpcreposix -lpcre -ldb-6.0 -lmagic -lcrypto -lbeecrypt -lbz2 -lz -lpopt -lpthread  -lelf -lpopt -lz -lssl -lcrypto -lpcre -lossp-uuid

