Import-Package: com.telit.appzone.azperspect,
 com.unifiedplugin.controls,
 com.unifiedplugin.exceptions,
 com.unifiedplugin.registry,
 com.unifiedplugin.resources,
 com.unifiedplugin.utilities,
 com.unifiedplugin.wizards,
 org.apache.commons.io
Export-Package: com.appzonec.plugin,
 com.appzonec.plugin.projects,
 com.appzonec.plugin.wizards
